# Base URL emitted by the backend SAM stack, without a trailing slash.
VITE_API_BASE_URL=https://example.execute-api.us-east-1.amazonaws.com

# Demo mode returns deterministic sample findings without reading DynamoDB.
VITE_DEMO_MODE=true

# Use in-browser sample data for a static portfolio deployment such as Pages.
VITE_STATIC_DEMO=false
